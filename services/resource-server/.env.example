# Hedera testnet account that RECEIVES x402 payments for verification calls.
# Public account ID only — no private key needed here; only the paying
# client (services/orchestrator) signs payments.
HEDERA_PAY_TO_ACCOUNT_ID=0.0.xxxxx

# Blocky402 hosted facilitator, testnet. No API key required.
BLOCKY402_FACILITATOR_URL=https://api.testnet.blocky402.com

HEDERA_NETWORK=hedera:testnet

# Price per verification call, in tinybars (1 HBAR = 10^8 tinybars).
# 100000 tinybars = 0.001 HBAR. Only used when X402_SETTLEMENT_ASSET=HBAR.
VERIFICATION_PRICE_TINYBAR=100000

# Which asset /verify's x402 price is denominated in: USDC (default, an HTS
# token — also @x402/hedera's own default settlement asset) or HBAR.
X402_SETTLEMENT_ASSET=USDC

# Price per verification call in testnet USDC base units (6 decimals).
# 10000 = $0.01. Only used when X402_SETTLEMENT_ASSET=USDC.
VERIFICATION_PRICE_USDC_BASE_UNITS=10000

PORT=4001

# Free-tier key from aistudio.google.com/apikey.
GEMINI_API_KEY=
