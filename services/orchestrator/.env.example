# Hedera testnet account that PAYS for verification calls via x402.
# Must use the ECDSA key (portal.hedera.com exposes both ECDSA and ED25519 —
# grab the ECDSA one; @x402/hedera requires PrivateKey.fromStringECDSA).
HEDERA_ACCOUNT_ID=0.0.xxxxx
HEDERA_PRIVATE_KEY=

HEDERA_NETWORK=hedera:testnet

RESOURCE_SERVER_URL=http://localhost:4001

PORT=4002

# From privy.io -> your app -> API keys.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Printed by `pnpm privy:setup-policy` (run once) — the receive-only policy
# applied to every respondent payout wallet.
PRIVY_RESPONDENT_POLICY_ID=

# From developer.world.org -> your app. Selfie Check needs an extra feature
# flag enabled by a World rep even for sandbox testing.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_SIGNING_KEY=
WORLD_ENVIRONMENT=sandbox

# From resend.com/api-keys. Free tier, no domain verification needed to
# start (uses the shared onboarding@resend.dev sender).
RESEND_API_KEY=
CLAIM_EMAIL_FROM=FormDrop <onboarding@resend.dev>

# apps/web base URL — the claim link in the email points here.
WEB_APP_URL=http://localhost:3000

# Printed by `pnpm hcs:setup-topic` (run once) — the HCS topic every
# verification verdict gets anchored to as a tamper-proof audit trail.
HCS_AUDIT_TOPIC_ID=

# From dashboard.stripe.com/test/apikeys — test mode, no billing needed.
# The card-funding path (alongside the existing send-testnet-HBAR-yourself
# path). STRIPE_WEBHOOK_SECRET comes from the webhook endpoint's signing
# secret (dashboard, or `stripe listen`'s printed secret while developing).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Nominal USD-cents-per-HBAR peg for pricing the checkout — testnet HBAR
# has no real value, this just makes "pay with a card" a coherent amount.
USD_CENTS_PER_HBAR=100
