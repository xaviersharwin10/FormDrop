# From privy.io -> your app -> API keys. Client-safe (App ID is public,
# never put the App Secret here).
NEXT_PUBLIC_PRIVY_APP_ID=

NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:4002

# Google Picker — lets a creator pick a form from Drive instead of pasting
# an ID. Client IDs aren't secret; this is the SAME client ID as the
# orchestrator's GOOGLE_FORMS_OAUTH_CLIENT_ID, with this app's origin added
# to that client's "Authorized JavaScript origins" in Cloud Console (a
# separate setting from the redirect URI the server-side flow uses).
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
# APIs & Services -> Credentials -> Create credentials -> API key. Restrict
# it (Websites) to this app's origin AND https://docs.google.com/* — the
# Picker renders in an iframe hosted on docs.google.com.
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
# Cloud project NUMBER (numeric, from the Console's project picker/dashboard) — not the project ID string.
NEXT_PUBLIC_GOOGLE_PICKER_APP_ID=
