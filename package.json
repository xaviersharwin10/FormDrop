{
  "name": "paid-forms",
  "private": true,
  "version": "0.1.0",
  "description": "Paid Forms — a Google Forms add-on that pays respondents the instant they submit a valid response.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:resource-server": "pnpm --filter @paid-forms/resource-server dev",
    "dev:orchestrator": "pnpm --filter @paid-forms/orchestrator dev",
    "dev:web": "pnpm --filter @paid-forms/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs"
    ]
  }
}
